	(text "SHT40 (0x44), 6 mm from the BME688" (exclude_from_sim no) (at 107.95 112.78 0) (effects (font (size 1.5 1.5) bold) (justify left top)) (uuid "c4f8ec5e-c5c1-5959-bf0d-b4b61406b117"))
	(text "Notes\n- BME688: gas and pressure only. Its\n  gas heater self-heats, so T/RH come\n  from the SHT40 away from it.\n- I2C addresses: BME688 0x77 (SDO high),\n  SHT40 0x44. CSB high selects I2C.\n- 4.7k pull-ups sit at the bus entry;\n  no pours on the sensor island." (exclude_from_sim no) (at 20.32 121.92 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3a201037-f63e-5595-b8b7-352151f691ff"))
