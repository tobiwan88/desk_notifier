	(text "3.3 V buck (TLV62569), Vout = 0.6 V * (1 + 100k/22k)"
		(exclude_from_sim no)
		(at 214.63 77.22 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "4d23b7f8-11d3-5b36-b331-0bbef76efc40")
	)
	(text "USB-C input"
		(exclude_from_sim no)
		(at 26.67 56.9 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "655e1ee4-c0bb-5601-bc48-07600625bf73")
	)
	(text "Notes\n- Buck instead of LDO: from 5 V an LDO would burn about 0.6 W and warm the sensors.\n- USB D+/D- are a 90 ohm pair (0.27 mm / 0.15 mm gap, top layer over In1 GND): keep short, ESD diode U2 right at J1.\n- CC1/CC2 5.1k to GND: the host offers 5 V. VBUS_IN is before the polyfuse, VBUS after it.\n- Layout: buck bottom centre, far from the BME688; input cap C1 at VIN, output caps at L1.\n- Output caps: C2 + C11 22 uF 0805 derate to about 11 uF each at 3.3 V; TLV62569 wants 10-47 uF effective."
		(exclude_from_sim no)
		(at 35.56 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "71e7aef7-766c-59f6-b950-aee74241c5e6")
	)
	(text "Power LED"
		(exclude_from_sim no)
		(at 321.31 77.22 0)
		(effects
