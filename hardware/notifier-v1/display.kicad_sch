	(text "Notes\n- JP1: 1-2 bridged = LCD_VCC from 3V3 (default, 3.3 V modules).\n  For 5 V modules cut the 1-2 bridge and bridge 2-3 (VBUS).\n- J2 pin order = module header: VCC, GND, SCL, SDA, DC, CS, RST\n  (no MISO, no backlight pin).\n- Display plugs in from the side; its face sits past the board edge."
		(exclude_from_sim no)
		(at 25.4 127 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8f0d5b6f-8241-5b29-8410-af78b99c673c")
	)
