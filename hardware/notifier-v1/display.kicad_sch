	(text "Notes\n- JP1: 1-2 bridged = LCD_VCC from 3V3 (default, 3.3 V modules).\n  For 5 V modules cut the 1-2 bridge and bridge 2-3 (VBUS).\n- J2 pin order (mirrored for the right-edge socket): RST, CS, DC, SDA, SCL, GND, VCC\n  (no MISO, no backlight pin).\n- Display plugs in from the side; its face sits past the board edge."
		(exclude_from_sim no)
		(at 25.4 127 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7243e6cb-63d6-5639-b2b6-8b05b1163495")
	)
